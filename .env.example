# Copy this file to .env. .env is gitignored.

# Owner key: used only by the curated live example. Uploaded-file runs use the visitor's key.
MODEL_API_KEY=
MODEL_PROVIDER=gemini
MODEL_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL_NAME=gemini-3.5-flash-lite
MODEL_REASONING_EFFORT=minimal
MODEL_MIN_INTERVAL_SECONDS=7

# Competition/local batch runner.
MAX_WORKERS=1
TASK_TIMEOUT_SECONDS=900
INPUT_ROOT=examples/benchmark
OUTPUT_ROOT=output
LOG_DIR=logs

# Web demo. Local default is loopback. render.yaml sets HOST=0.0.0.0;
# the host injects PORT. Always serve the public page over HTTPS.
HOST=127.0.0.1
PORT=8765
PUBLIC_TASK_TIMEOUT_SECONDS=180
OWNER_DAILY_LIMIT=20
OWNER_COOLDOWN_SECONDS=60
BYOK_CONCURRENCY=2
